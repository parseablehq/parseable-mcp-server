# Copy to .env.docker and fill in. .env.docker is gitignored via .dockerignore.

# HTTP server
PORT=8787
MCP_PUBLIC_BASE_URL=http://localhost:8787

# Clerk OAuth (staging keys for local dev)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Parseable orchestrator (if used for workspace lookup)
PARSEABLE_URL=https://staging.parseable.com

# Optional tool defaults
PARSEABLE_DEFAULT_DATASET=
PARSEABLE_MAX_ROWS=1000
PARSEABLE_QUERY_TIMEOUT_MS=30000
