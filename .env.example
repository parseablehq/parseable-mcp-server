# Parseable instance (used by MCP tools)
PARSEABLE_URL=http://localhost:8000
PARSEABLE_API_KEY=your-api-key

# Optional tool defaults
PARSEABLE_DEFAULT_DATASET=
PARSEABLE_MAX_ROWS=1000
PARSEABLE_QUERY_TIMEOUT_MS=30000

# HTTP mode (used when running: node dist/server.js http)
PORT=8787
PARSEABLE_MCP_ALLOW_PRIVATE=false
