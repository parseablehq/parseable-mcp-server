# Parseable instance (used by MCP tools)
PARSEABLE_URL=http://localhost:8000
PARSEABLE_API_KEY=your-api-key

# Optional tool defaults
PARSEABLE_DEFAULT_DATASET=
PARSEABLE_MAX_ROWS=1000
PARSEABLE_QUERY_TIMEOUT_MS=30000

# HTTP / OAuth mode (required when running: node dist/server.js http)
PORT=8787
MCP_PUBLIC_BASE_URL=http://localhost:8787

# Clerk OAuth — get from Clerk Dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
