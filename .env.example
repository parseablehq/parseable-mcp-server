# Parseable instance (used by MCP tools)
PARSEABLE_URL=http://localhost:8000
PARSEABLE_API_KEY=your-api-key

# Optional tool defaults
PARSEABLE_DEFAULT_DATASET=
PARSEABLE_MAX_ROWS=1000
PARSEABLE_QUERY_TIMEOUT_MS=30000

# HTTP mode (used when running: node dist/server.js http)
PORT=8787
PARSEABLE_MCP_ALLOW_PRIVATE=false

# Parseable Cloud API-key resolution (required only for X-Parseable-Mode: cloud)
PARSEABLE_ORCHESTRATOR_URL=https://cloud-api.example.com
PARSEABLE_CLOUD_AUTH_TOKEN=your-orchestrator-service-token
PARSEABLE_CLOUD_CACHE_TTL_SECONDS=86400
PARSEABLE_CLOUD_CACHE_MAX_ENTRIES=10000
PARSEABLE_CLOUD_VALIDATE_TIMEOUT_MS=10000
